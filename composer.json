{
    "name": "horde/http_server",
    "description": "HTTP Request Handling Library adhering to PSR-15 standard. This evolved out of horde/controller.",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Controller",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "lang@b1-systems.de",
            "role": "lead"
        }
    ],
    "keywords": [
        "middleware",
        "requesthandler",
        "psr15"
    ],
    "time": "2026-07-01",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "psr/http-server-middleware": "^1",
        "psr/http-server-handler": "^1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/http": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {
        "psr/container": "^2.02",
        "horde/injector": "* || dev-FRAMEWORK_6_0",
        "ext-mbstring": "*",
        "ext-zlib": "*"
    },
    "autoload": {
        "psr-4": {
            "Horde\\Http\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Http\\Server\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "provide": {
        "psr/http-server-middleware-implementation": "^1",
        "psr/http-server-handler-implementation": "^1"
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "1.x-dev"
        }
    }
}